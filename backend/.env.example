# ============================================================
# GOIP Backend — Environment Configuration
# Copy this file to .env and fill in your values.
# NEVER commit the actual .env file to version control.
# ============================================================

# --- Supabase Configuration ---
# Get these from: Supabase Dashboard -> Project Settings -> API Keys
SUPABASE_URL=https://your-project-ref.supabase.co
# Modern server secret key (recommended for server-side code)
SUPABASE_SECRET_KEY=
# Legacy server service role key (supported for backwards compatibility)
SUPABASE_SERVICE_ROLE_KEY=
# Publishable / Anon key (used for client verification)
SUPABASE_PUBLISHABLE_KEY=
SUPABASE_ANON_KEY=

# --- JWT Verification ---
# Get this from: Supabase → Project → Settings → API → JWT Secret
SUPABASE_JWT_SECRET=your-jwt-secret-here

# --- Application Settings ---
APP_NAME=GOIP Government File Tracking System
APP_VERSION=1.0.0
DEBUG=true

# --- CORS Origins (comma-separated) ---
# Add your Netlify URL here for production
CORS_ORIGINS=http://localhost:5173,http://localhost:5174,http://127.0.0.1:5173

# --- Storage ---
SUPABASE_STORAGE_BUCKET=gov-documents
MAX_UPLOAD_SIZE_MB=20

# --- OCR Configuration ---
# Path to Tesseract executable (Windows: C:/Program Files/Tesseract-OCR/tesseract.exe)
# Leave empty to use system PATH
TESSERACT_CMD=

# --- Logging ---
LOG_LEVEL=INFO
