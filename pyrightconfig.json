{
  "include": [
    "backend"
  ],
  "exclude": [
    "**/node_modules",
    "**/__pycache__",
    "**/.pytest_cache",
    "**/dist",
    "**/.pyretty_virtual",
    "**/.pyretty_virtual/**",
    "**/.pyrefly_virtual",
    "**/.pyrefly_virtual/**",
    "**/_inmemory",
    "**/_inmemory/**",
    "**/*_inmemory*",
    "**/*_inmemory*/**",
    "**/.venv",
    "**/.venv/**"
  ],
  "pythonVersion": "3.10",
  "venvPath": "backend",
  "venv": ".venv",
  "extraPaths": [
    "backend"
  ],
  "reportMissingImports": "warning",
  "reportMissingModuleSource": "none"
}
