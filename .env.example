# ============================================================
# GOIP Frontend Environment Configuration
# Copy this file to .env and fill in your values.
# ============================================================

# Mock Mode (Set to false when connecting to live Supabase / live backend)
# When true, you can still test Google Sign-in locally with sample data.
# When false, Google Sign-in redirects to your live Supabase Google OAuth provider.
VITE_USE_MOCK_API=false

# Live Backend REST Endpoint (FastAPI backend running at port 8000)
VITE_API_BASE_URL=http://localhost:8000

# ============================================================
# Supabase Configuration
# Get these from: Supabase Dashboard -> Project Settings -> API
# ============================================================
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key-here
