# ============================================================
# GOIP Environment Configuration
# Copy this file to .env and fill in your values.
# ============================================================

# Mock Mode (default: true for synthetic dataset presentation)
# Set to false to connect to the live Python/FastAPI backend
VITE_USE_MOCK_API=true

# Live Backend REST Endpoint (FastAPI backend running at port 8000)
# When VITE_USE_MOCK_API=false, all API calls go to this URL
VITE_API_BASE_URL=http://localhost:8000

# Supabase (only used if you add direct client-side Supabase calls)
# The service role key is NEVER exposed here — it is backend-only
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...your-anon-key

